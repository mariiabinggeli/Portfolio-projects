#preprocessing
import numpy as np
import pandas as pd
from sklearn.impute import SimpleImputer

# Replace zeros with NaN in key columns
zero_to_nan_cols = ['Glucose', 'BloodPressure', 'SkinThickness', 'Insulin', 'BMI']
df[zero_to_nan_cols] = df[zero_to_nan_cols].replace(0, np.nan)

# Impute missing values with median (more robust than mean for medical data)
imputer = SimpleImputer(strategy='median')
df[zero_to_nan_cols] = imputer.fit_transform(df[zero_to_nan_cols])

# Feature egineering
# Age categories
df['AgeGroup'] = pd.cut(df['Age'],
                       bins=[20, 30, 40, 50, 60, 70, 80],
                       labels=['20-29', '30-39', '40-49', '50-59', '60-69', '70-79'])

# BMI categories (WHO standards)
df['BMICategory'] = pd.cut(df['BMI'],
                          bins=[0, 18.5, 25, 30, 35, 40, 100],
                          labels=['Underweight', 'Normal', 'Overweight',
                                 'Obese I', 'Obese II', 'Obese III'])

# Glucose categories
df['GlucoseCategory'] = pd.cut(df['Glucose'],
                              bins=[0, 70, 100, 125, 200, 300],
                              labels=['Hypoglycemia', 'Normal', 'Prediabetes',
                                     'Diabetes', 'Severe Hyperglycemia'])

# Interaction terms
df['Glucose_BMI'] = df['Glucose'] * df['BMI']
df['Age_Insulin'] = df['Age'] * df['Insulin']


#feature scaling
from sklearn.preprocessing import StandardScaler

scaler = StandardScaler()
scaled_features = scaler.fit_transform(df[['Glucose', 'BloodPressure', 'SkinThickness',
                                         'Insulin', 'BMI', 'DiabetesPedigreeFunction', 'Age']])
df_scaled = pd.DataFrame(scaled_features, columns=['Glucose_scaled', 'BP_scaled', 'SkinThickness_scaled',
                                                 'Insulin_scaled', 'BMI_scaled', 'DPF_scaled', 'Age_scaled'])
df = pd.concat([df, df_scaled], axis=1)

# No scaling needed for tree-based models
# But we'll one-hot encode categorical variables
df = pd.get_dummies(df, columns=['AgeGroup', 'BMICategory', 'GlucoseCategory'], drop_first=True)

